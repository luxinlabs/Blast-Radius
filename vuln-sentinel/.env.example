# Prefer `sentinel init-demo` to generate unique local credentials.
SENTINEL_BACKEND=demo
SENTINEL_URL=http://127.0.0.1:8000
SENTINEL_CLIENT_ID=demo-app
# JSON mapping: token -> {subject, role, client_id}. Token length >=24.
# Roles: admin (fleet), agent (one client), reviewer (one client), reader (one client).
SENTINEL_TOKENS={}
SENTINEL_TOKEN=
SENTINEL_ADMIN_TOKEN=
SENTINEL_REVIEWER_TOKEN=
# For live deployment:
# SENTINEL_BACKEND=snowflake
# SNOWFLAKE_CONNECTION_NAME=vuln_sentinel
# Snowflake credentials stay in connections.toml / platform secret storage.

# Public MCP deployments: comma-separated exact host/origin values.
# SENTINEL_ALLOWED_HOSTS=sentinel.example.com
# SENTINEL_ALLOWED_ORIGINS=https://sentinel.example.com
